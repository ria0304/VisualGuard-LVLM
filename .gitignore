# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Testing / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Experiment artefacts. Results are regenerated by src/run.py and are not
# committed, so that reported numbers always correspond to a recorded run.
results/*
!results/.gitkeep

# Datasets and checkpoints must never be committed.
data/
datasets/
coco/
POPE/
MME/
*.jsonl
*.zip
*.tar.gz
*.safetensors
*.bin
*.pt
*.pth
*.ckpt

# Editor / OS
.vscode/
.idea/
.DS_Store
*.swp
