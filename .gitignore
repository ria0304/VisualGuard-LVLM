.ruff_cache/
.coverage
htmlcov/

# Experiment results ARE committed (results/ and output/), so reported numbers
# stay tied to a recorded run. Only large per-sample dumps below are ignored.

# Datasets and checkpoints must never be committed.
/data/
/datasets/
/coco/
/POPE/
/MME/
*.jsonl
!/results/**/*.jsonl
!/output/**/*.jsonl
*.zip
*.tar.gz
*.safetensors
*.bin
*.pt
*.pth
*.ckpt

# Editor / OS
.vscode/
.idea/
.DS_Store
*.swp
